<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>
  <name>Sized Apparel Auto-Refit</name>
  <author>DanZinagri</author>
  <packageId>DanZinagri.SizedApparelAutoRefit</packageId>
  <supportedVersions>
    <li>1.6</li>
    <li>1.7</li>
  </supportedVersions>
  <description>Automatically generates the sized apparel textures that Sized Apparel for RJW expects, for any garment that has no hand-drawn size variants..</description>
  <modDependencies>
    <li>
      <packageId>brrainz.harmony</packageId>
      <displayName>Harmony</displayName>
      <steamWorkshopUrl>steam://url/CommunityFilePage/2009463077</steamWorkshopUrl>
      <downloadUrl>https://github.com/pardeike/HarmonyRimWorld/releases/latest</downloadUrl>
    </li>
    <li>
      <packageId>OTYOTY.SizedApparel</packageId>
      <displayName>Sized Apparel for RJW</displayName>
    </li>
  </modDependencies>
  <loadAfter>
    <li>brrainz.harmony</li>
    <li>rim.job.world</li>
    <li>OTYOTY.SizedApparel</li>
    <li>erdelf.HumanoidAlienRaces</li>
  </loadAfter>
</ModMetaData>
